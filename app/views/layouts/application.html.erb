<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || Rails.configuration.x.product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Rails.configuration.x.product_name %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= logged_in? ? "app-body" : "auth-body" %>">
    <a class="skip-link" href="#main-content">Ana içeriğe geç</a>

    <% if logged_in? %>
      <div class="app-shell">
        <aside class="sidebar">
          <div class="sidebar-brand"><%= render "shared/brand" %></div>

          <nav class="primary-nav" aria-label="Ana menü">
            <span class="nav-section-label">Çalışma alanı</span>
            <% if current_user.employee? %>
              <%= link_to approval_documents_path,
                          class: ["nav-item", { active: controller_name == "approval_documents" && !%w[new create].include?(action_name) }] do %>
                <span class="nav-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false"><path d="M4.5 3.5h8l3 3v10h-11zM12.5 3.5v3h3M7 10h6M7 13h4"/></svg>
                </span>
                <span>Belgelerim</span>
              <% end %>
              <%= link_to new_approval_document_path,
                          class: ["nav-item", { active: controller_name == "approval_documents" && %w[new create].include?(action_name) }] do %>
                <span class="nav-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false"><path d="M10 4v12M4 10h12"/></svg>
                </span>
                <span>Yeni belge</span>
              <% end %>
            <% else %>
              <%= link_to pending_approval_documents_path,
                          class: ["nav-item", { active: controller_name == "approval_documents" }] do %>
                <span class="nav-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false"><path d="M3.5 10.5 7.5 14l9-9M4 4.5h5M4 7.5h3M11.5 15.5H16"/></svg>
                </span>
                <span>Onay paneli</span>
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-account">
            <span class="account-avatar" aria-hidden="true"><%= user_initials(current_user) %></span>
            <span class="account-copy">
              <strong><%= current_user.name %></strong>
              <span><%= role_label(current_user) %></span>
            </span>
            <%= button_to logout_path,
                          method: :delete,
                          class: "logout-button",
                          title: "Güvenli çıkış",
                          aria: { label: "Çıkış yap" } do %>
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M8 3.5H4.5v13H8M12 6l4 4-4 4M7 10h9"/></svg>
              <span>Çıkış</span>
            <% end %>
          </div>
        </aside>

        <div class="app-workspace">
          <header class="topbar">
            <div class="topbar-context">
              <span class="topbar-status" aria-hidden="true"></span>
              <div>
                <span class="topbar-label">Güvenli çalışma alanı</span>
                <strong>Belge onay merkezi</strong>
              </div>
            </div>
            <div class="topbar-user">
              <span class="timezone-note"><%= onayflow_time_zone_label %></span>
              <span class="topbar-divider" aria-hidden="true"></span>
              <div>
                <strong><%= current_user.name %></strong>
                <span><%= role_label(current_user) %></span>
              </div>
            </div>
          </header>

          <main class="main-content" id="main-content" tabindex="-1">
            <% flash.each do |type, message| %>
              <div class="flash flash-<%= type %>" role="status"><%= message %></div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="auth-shell" id="main-content" tabindex="-1">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>" role="status"><%= message %></div>
        <% end %>

        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
