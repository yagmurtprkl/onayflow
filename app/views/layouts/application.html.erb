<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || Rails.configuration.x.product_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= Rails.configuration.x.product_name %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= logged_in? ? "app-body" : "auth-body" %>">
    <% if logged_in? %>
      <div class="app-shell">
        <aside class="sidebar">
          <div class="sidebar-brand"><%= render "shared/brand" %></div>

          <nav class="primary-nav" aria-label="Ana menü">
            <% if current_user.employee? %>
              <%= link_to approval_documents_path,
                          class: ["nav-item", { active: current_page?(approval_documents_path) }] do %>
                <span class="nav-icon" aria-hidden="true">▦</span>
                Belgelerim
              <% end %>
              <%= link_to new_approval_document_path,
                          class: ["nav-item", { active: current_page?(new_approval_document_path) }] do %>
                <span class="nav-icon" aria-hidden="true">＋</span>
                Yeni belge
              <% end %>
            <% else %>
              <%= link_to pending_approval_documents_path,
                          class: ["nav-item", { active: current_page?(pending_approval_documents_path) }] do %>
                <span class="nav-icon" aria-hidden="true">✓</span>
                Onay paneli
              <% end %>
            <% end %>
          </nav>

          <div class="sidebar-account">
            <span class="role-chip"><%= role_label(current_user) %></span>
            <strong><%= current_user.name %></strong>
            <span class="account-email"><%= current_user.email %></span>
            <span class="timezone-note"><%= onayflow_time_zone_label %></span>
            <%= button_to "Çıkış yap", logout_path, method: :delete, class: "logout-button" %>
          </div>
        </aside>

        <div class="app-workspace">
          <header class="topbar">
            <div>
              <span class="topbar-label">Belge onay çalışma alanı</span>
              <strong><%= Rails.configuration.x.product_name %></strong>
            </div>
            <div class="topbar-user">
              <span><%= role_label(current_user) %></span>
              <strong><%= current_user.name %></strong>
            </div>
          </header>

          <main class="main-content">
            <% flash.each do |type, message| %>
              <div class="flash flash-<%= type %>" role="status"><%= message %></div>
            <% end %>

            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main class="auth-shell">
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type %>" role="status"><%= message %></div>
        <% end %>

        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
