<% content_for :title, "Belgeyi Düzenle | OnayFlow" %>

<nav class="breadcrumbs" aria-label="Sayfa yolu">
  <%= link_to "Belgelerim", approval_documents_path %>
  <span aria-hidden="true">/</span>
  <%= link_to @approval_document.title, @approval_document %>
  <span aria-hidden="true">/</span>
  <span>Düzenle</span>
</nav>

<header class="page-header form-page-header">
  <div>
    <span class="eyebrow">Taslak belge</span>
    <h1>Belgeyi düzenle</h1>
    <p>Başlığı, içeriği veya onaylayacak yöneticiyi güncelleyin.</p>
  </div>
</header>

<div class="form-layout">
  <section class="panel form-panel">
    <div class="form-panel-heading">
      <span class="form-step">01</span>
      <div>
        <h2>Taslak bilgileri</h2>
        <p>Belgeniz onaya gönderilmeden önce gerekli alanları güncelleyin.</p>
      </div>
    </div>
    <%= render "form", approval_document: @approval_document %>
  </section>

  <aside class="panel form-guidance">
    <span class="guidance-icon" aria-hidden="true">i</span>
    <h2>Taslak güvencesi</h2>
    <p>Bu belge hâlâ taslak durumunda. Kaydetme işlemi belgeyi otomatik olarak onaya göndermez.</p>
    <p>Hazır olduğunuzda belge detayındaki <strong>Onaya gönder</strong> eylemini kullanın.</p>
  </aside>
</div>
