<% content_for :title, "#{@approval_document.title} | OnayFlow" %>

<nav class="breadcrumbs" aria-label="Sayfa yolu">
  <%= link_to(current_user.manager? ? "Onay paneli" : "Belgelerim",
              current_user.manager? ? pending_approval_documents_path : approval_documents_path) %>
  <span aria-hidden="true">/</span>
  <span>Belge detayı</span>
</nav>

<header class="page-header">
  <div>
    <span class="eyebrow">Belge #<%= @approval_document.id %></span>
    <h1><%= @approval_document.title %></h1>
    <p>Belgenin içeriğini ve karar sürecindeki güncel durumunu inceleyin.</p>
  </div>
  <span class="timezone-pill"><%= onayflow_time_zone_label %></span>
</header>

<div class="document-layout">
  <article class="panel document-card">
    <div class="document-card-header">
      <span class="document-type-icon" aria-hidden="true">Aa</span>
      <div>
        <span class="meta-label">Belge içeriği</span>
        <h2>Talep ayrıntıları</h2>
      </div>
    </div>

    <div class="document-section">
      <div class="document-content"><%= @approval_document.content %></div>
    </div>

    <% if @approval_document.rejected? %>
      <div class="decision-note rejection-note">
        <span class="meta-label">Ret gerekçesi</span>
        <p><%= @approval_document.rejection_reason %></p>
      </div>
    <% end %>
  </article>

  <aside class="decision-column">
    <section class="panel summary-card">
      <div class="summary-card-header">
        <div>
          <span class="meta-label">Güncel durum</span>
          <div class="inline-badges">
            <span class="<%= approval_status_class(@approval_document) %>"><%= approval_status_label(@approval_document) %></span>
            <% if current_user.manager? && @approval_document.pending? %>
              <span class="<%= next_action_class(@approval_document) %>">
                <span class="priority-symbol" aria-hidden="true"></span>
                <%= next_action_label(@approval_document) %>
              </span>
            <% end %>
          </div>
        </div>
        <% if @approval_document.pending? %>
          <strong class="summary-time"><%= due_time_label(@approval_document) %></strong>
        <% end %>
      </div>

      <dl class="summary-list">
        <div>
          <dt>Talep eden</dt>
          <dd><%= @approval_document.requester.name %></dd>
        </div>
        <div>
          <dt>Onaylayan</dt>
          <dd><%= @approval_document.approver.name %></dd>
        </div>
        <div>
          <dt>Gönderilme</dt>
          <dd><%= onayflow_datetime(@approval_document.submitted_at) %></dd>
        </div>
        <div>
          <dt>Karar son tarihi</dt>
          <dd><%= onayflow_datetime(@approval_document.due_at) %></dd>
        </div>
        <div>
          <dt>Son karar</dt>
          <dd><%= onayflow_datetime(@approval_document.decided_at) %></dd>
        </div>
      </dl>
    </section>

    <% if current_user.employee? && @approval_document.editable_by?(current_user) %>
      <section class="panel action-card">
        <span class="eyebrow">Taslak işlemleri</span>
        <h2>Belgeyi tamamlayın</h2>
        <p>Onaya gönderdikten sonra belge içeriği değiştirilemez.</p>
        <div class="stacked-actions">
          <%= link_to "Taslağı düzenle", edit_approval_document_path(@approval_document), class: "button secondary-button" %>
          <%= button_to "Onaya gönder",
                        submit_approval_document_path(@approval_document),
                        method: :post,
                        class: "button primary-button full-width",
                        data: { turbo_submits_with: "Gönderiliyor…" },
                        form: { data: { turbo_confirm: "Belgeyi onaya göndermek istiyor musunuz?" } } %>
        </div>
      </section>
    <% end %>

    <% if current_user.manager? && @approval_document.pending? %>
      <section class="panel action-card">
        <span class="eyebrow">Karar işlemi</span>
        <h2>Belgeyi değerlendirin</h2>
        <p>Onay veya ret kararı verildiğinde işlem geri alınamaz.</p>
        <%= button_to "Belgeyi onayla",
                      approve_approval_document_path(@approval_document),
                      method: :post,
                      class: "button success-button full-width",
                      data: { turbo_submits_with: "Onaylanıyor…" },
                      form: { data: { turbo_confirm: "Belgeyi onaylamak istiyor musunuz?" } } %>

        <div class="decision-divider"><span>veya</span></div>

        <%= form_with url: reject_approval_document_path(@approval_document), method: :post, class: "stacked-form" do |form| %>
          <div class="form-group">
            <%= form.label :rejection_reason, "Ret gerekçesi" %>
            <%= form.text_area :rejection_reason,
                               required: true,
                               rows: 4,
                               placeholder: "Kararın gerekçesini açıkça yazın" %>
          </div>
          <%= form.submit "Gerekçeyle reddet",
                          class: "button danger-button full-width",
                          data: { turbo_submits_with: "Reddediliyor…" } %>
        <% end %>
      </section>
    <% elsif !@approval_document.draft? %>
      <section class="panel action-card completed-card">
        <span class="eyebrow">Akış durumu</span>
        <h2><%= @approval_document.pending? ? "Karar bekleniyor" : "İşlem tamamlandı" %></h2>
        <p>Belgenin güncel durumu yukarıdaki bilgilerde gösterilmektedir.</p>
      </section>
    <% end %>
  </aside>
</div>
